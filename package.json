{
  "name": "planning-poker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Planning Picker — a deliberately simple, self-hosted, real-time planning-poker app",
  "workspaces": [
    "shared",
    "BE",
    "FE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @pp/be",
    "build": "npm run build --workspace @pp/be && npm run build --workspace @pp/fe",
    "dev:be": "npm run dev --workspace @pp/be",
    "dev:fe": "npm run dev --workspace @pp/fe"
  },
  "devDependencies": {
    "oxlint": "^1.70.0",
    "prettier": "3.8.5",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@rc"
  }
}
