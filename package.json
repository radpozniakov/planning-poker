{
  "name": "planning-poker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Planning Picker — a deliberately simple, self-hosted, real-time planning-poker app",
  "workspaces": [
    "shared",
    "BE",
    "FE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @pp/be",
    "build": "npm run build --workspace @pp/be && npm run build --workspace @pp/fe",
    "dev:be": "npm run dev --workspace @pp/be",
    "dev:fe": "npm run dev --workspace @pp/fe",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "husky": "9.1.7",
    "oxlint": "^1.70.0",
    "prettier": "3.8.5",
    "typescript": "^7.0.1-rc"
  }
}
